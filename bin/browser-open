#!/bin/bash
shopt -s extglob

# There's a matching ../.local/share/applications/browser-open.desktop

# Add domains here (one per line, no https://, wildcards allowed)
EDGE_DOMAINS="
aka.ms
eng.ms
teams.cloud.microsoft
teams.microsoft.com
dev.azure.com
*.visualstudio.com
ra.ev2portal.*
*.microsofticm.com
microsoft.sharepoint.com
*.microsoft.com
*.windows.net
*.azurefd.net
*.cloud.microsoft
arohcp-int*.grafana.azure.com
arohcp-stg-*.grafana.azure.com
arohcp-prod-*.grafana.azure.com
"

# Add URL prefixes here (domain + path prefix, no https://). Matches anything
# starting with this prefix, e.g. "dataexplorer.azure.com/clusters/hcp-prod-"
EDGE_PREFIXES="
dataexplorer.azure.com/clusters/hcp-prod-
dataexplorer.azure.com/clusters/hcp-stg-
dataexplorer.azure.com/clusters/hcp-int-
lionrock-
"

for domain in $EDGE_DOMAINS; do
	case "$1" in
		http?(s)://$domain|http?(s)://$domain/*)
			exec edge "$@"
			;;
	esac
done

for prefix in $EDGE_PREFIXES; do
	case "$1" in
		http?(s)://$prefix*)
			exec edge "$@"
			;;
	esac
done

exec google-chrome-stable "$@"
