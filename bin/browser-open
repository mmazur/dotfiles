#!/bin/sh

# Add domains here (one per line, no https://, wildcards allowed)
EDGE_DOMAINS="
aka.ms
eng.ms
teams.cloud.microsoft
teams.microsoft.com
dev.azure.com
msazure.visualstudio.com
ra.ev2portal.*
portal.microsofticm.com
microsoft.sharepoint.com
"

for domain in $EDGE_DOMAINS; do
	case "$1" in
		https://$domain|https://$domain/*)
			exec edge "$@"
			;;
	esac
done

exec google-chrome-stable "$@"
